# App configuration (copy to .env to override defaults)
# Prefix: APP_

APP_ENVIRONMENT=development
APP_DEBUG=false
APP_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/token_cost_estimator
APP_LOG_LEVEL=info

# Docker entrypoint seeds pricing on boot only when true (dev convenience).
# Production: seed explicitly, leave this off.
APP_SEED_PRICING=false

# Guardrails
APP_MAX_PROMPT_CHARS=200000
APP_MAX_EXPECTED_OUTPUT_TOKENS=1000000

# CORS (comma-separated) — empty disables
APP_CORS_ORIGINS=

# Alerts (Phase 13)
APP_ALERTS_ENABLED=true
APP_ALERT_ANOMALY_MIN_SAMPLES=10
APP_ALERT_ANOMALY_LOOKBACK=100
APP_ALERT_ANOMALY_MULTIPLIER=50
APP_ALERT_ANOMALY_ABSOLUTE_MIN_USD=5.00
APP_ALERT_ANOMALY_CRITICAL_USD=10.00
APP_ALERT_ANOMALY_VARIANCE_PERCENT=400

# Generation (Phases 14–15) — off by default. Requires a key to spend real money.
APP_GENERATE_ENABLED=false
APP_OPENAI_API_KEY=
APP_OPENAI_BASE_URL=
APP_OPENAI_TIMEOUT_SECONDS=60

# Observability (Phase 16)
APP_METRICS_ENABLED=true
APP_SERVICE_NAME=token-cost-estimator

# Security (Phase 17). Comma-separated API keys; admin keys are a superset.
# NOTE: empty keys do NOT disable auth — every /v1 call returns 401.
# Production requires both keys (boot fails without them).
# DEV-ONLY bypass: APP_AUTH_DISABLED=true lets local dev run without keys.
# The boot guard refuses APP_AUTH_DISABLED outside development.
APP_API_KEYS=
APP_ADMIN_API_KEYS=
APP_AUTH_DISABLED=false
# APP_AUTH_HASH_KEYS=true means the values below are sha256 hex digests, not
# plaintext (generate: uv run python scripts/hash_api_keys.py <key>).
APP_API_KEYS=
APP_ADMIN_API_KEYS=
APP_AUTH_HASH_KEYS=false
APP_RATE_LIMIT_PER_MINUTE=60
APP_RATE_LIMIT_GENERATE_PER_MINUTE=10